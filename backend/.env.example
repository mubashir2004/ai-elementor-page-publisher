# Backend environment. Set these in Railway Variables for the public deployment.
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
# Generate locally; never commit real values:
# openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
# 32 random bytes, encoded as 64 hex chars (AES-256-GCM credential encryption)
# openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
# Set your Anthropic API key directly in Railway Variables; never in frontend or GitHub.
ANTHROPIC_API_KEY=replace-with-server-side-anthropic-key
EAI_DATA_DIR=./data

# Optional: email every student WP credential submission to the instructor.
# Example for Gmail (create an App Password at https://myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-gmail@gmail.com
# NOTIFY_EMAIL=mubashirhayat77@gmail.com
